# Standalone Rahtal MCP credentials: placeholders only; never commit real values.
RAHTAL_BASE_URL=https://stage.example.rahtal.invalid/
RAHTAL_USERNAME=your_username
RAHTAL_PASSWORD=your_password
RAHTAL_TIMEOUT_SECONDS=15
RAHTAL_VERIFY_SSL=true

# Optional smoke-test gates. Read-only smoke tests require the first flag.
RAHTAL_SMOKE_READ_ONLY=false
RAHTAL_SMOKE_ALLOW_WRITE=false
RAHTAL_SMOKE_ENVIRONMENT=staging
RAHTAL_SMOKE_TASK_ID=
RAHTAL_SMOKE_TITLE_ID=
RAHTAL_SMOKE_START_TIME=
RAHTAL_SMOKE_END_TIME=
